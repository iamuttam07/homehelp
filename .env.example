# Copy to .env and adjust. Never commit .env.

# PostgreSQL
POSTGRES_DB=homehelp
POSTGRES_USER=homehelp
POSTGRES_PASSWORD=homehelp_dev_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MailHog (local email testing)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Auth (read by the API, not by docker compose). Generate with: openssl rand -base64 48
# JWT_SECRET=
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=14d

# First admin (read by the API at startup). Created only if both are set and the
# email isn't registered yet. Password: at least 12 characters.
# HOMEHELP_ADMIN_EMAIL=admin@example.com
# HOMEHELP_ADMIN_PASSWORD=
