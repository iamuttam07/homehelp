    {
      "name": "16. Available slots",
      "item": [
        {
          "name": "Slots next Monday",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Next Monday at least two days away, the Tuesday after it, and two out-of-range dates.",
                  "const ymd = d => d.toISOString().slice(0, 10);",
                  "const d = new Date(); d.setUTCDate(d.getUTCDate() + 2);",
                  "while (d.getUTCDay() !== 1) d.setUTCDate(d.getUTCDate() + 1);",
                  "pm.collectionVariables.set('monday', ymd(d));",
                  "const t = new Date(d); t.setUTCDate(t.getUTCDate() + 1); pm.collectionVariables.set('tuesday', ymd(t));",
                  "const past = new Date(); past.setUTCDate(past.getUTCDate() - 2); pm.collectionVariables.set('pastDate', ymd(past));",
                  "const far = new Date(); far.setUTCDate(far.getUTCDate() + 32); pm.collectionVariables.set('farDate', ymd(far));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const local = (s, tz) => new Date(s).toLocaleTimeString('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit' });",
                  "pm.test('Service and date echoed', () => { pm.expect(body.service.slug).to.eql('leak-repair'); pm.expect(body.service.durationMinutes).to.eql(60); pm.expect(body.date).to.eql(pm.collectionVariables.get('monday')); pm.expect(body.timeZone).to.eql('Europe/London'); });",
                  "pm.test('Five half-hourly starts, 09:00 to 11:00 London', () => pm.expect(body.slots.map(s => local(s.start, 'Europe/London'))).to.eql(['09:00', '09:30', '10:00', '10:30', '11:00']));",
                  "pm.test('Each slot lasts an hour', () => pm.expect(local(body.slots[0].end, 'Europe/London')).to.eql('10:00'));",
                  "pm.test('At least one provider per slot', () => body.slots.forEach(s => pm.expect(s.availableProviders).to.be.at.least(1)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/slots?service=leak-repair&date={{monday}}&addressId={{addressId}}",
